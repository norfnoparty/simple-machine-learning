// schema.prisma

generator client {
  provider = "prisma-client-js"
}

// Konfigurasi untuk PostgreSQL (Supabase)
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Opsional, sering dipakai di Supabase untuk koneksi pooling
}

enum Role {
  EMPLOYEE
  HRD
  BOD
}

enum StatusPengajuan {
  PENDING
  APPROVED
  REJECTED
}

enum StatusPresensi {
  HADIR
  TERLAMBAT
  TIDAK_HADIR
  CUTI_IZIN
  TANPA_CLOCK_OUT
  PULANG_CEPAT
}

// ----------------------------------------------------------------------
// MODELS
// ----------------------------------------------------------------------

model Departemen {
  id        Int        @id @default(autoincrement()) @map("id_departemen")
  nama      String

  // Relasi: Satu Departemen punya banyak Pengguna
  pengguna  Pengguna[]

  @@map("departemen")
}

model Pengguna {
  id            Int       @id @default(autoincrement()) @map("id_pengguna")
  pin           String?   @unique
  idDepartemen  Int?      @map("id_departemen")
  jamMasuk      DateTime  @db.Time @map("jam_masuk")   // Jam masuk karyawan (mis. 08:00)
  jamKeluar     DateTime  @db.Time @map("jam_keluar")  // Jam keluar karyawan (mis. 17:00)
  toleransiMenit Int      @default(15) @map("toleransi_menit") // Toleransi keterlambatan (menit)
  nama          String
  email         String    @unique
  role          Role      @default(EMPLOYEE)
  jabatan       String?
  password      String

  // Relasi
  departemen Departemen? @relation(fields: [idDepartemen], references: [id])
  presensi   Presensi[]
  cutiIzin   CutiIzin[]
  lembur     Lembur[]
  auditLog   AuditLog[]

  @@map("pengguna")
}

model Presensi {
  id              Int            @id @default(autoincrement()) @map("id_presensi")
  idPengguna      Int            @map("id_pengguna")
  tanggalPresensi DateTime       @db.Date @map("tanggal_presensi")
  jamMasuk        DateTime       @db.Time @map("jam_masuk")
  jamKeluar       DateTime?      @db.Time @map("jam_keluar") // Bisa null jika belum clock out
  status          StatusPresensi @default(HADIR) @map("status")

  // Relasi
  pengguna Pengguna @relation(fields: [idPengguna], references: [id], onDelete: Cascade)

  @@unique([idPengguna, tanggalPresensi], name: "id_pengguna_tanggal_presensi")
  @@map("presensi")
}

model CutiIzin {
  id             Int             @id @default(autoincrement()) @map("id_cuti_izin")
  idPengguna     Int             @map("id_pengguna")
  jenisCutiIzin  String          @map("jenis_cuti_izin") // Bisa diubah jadi Enum jika datanya pasti
  tanggalMulai   DateTime        @db.Date @map("tanggal_mulai")
  tanggalSelesai DateTime        @db.Date @map("tanggal_selesai")
  alasan         String          @db.Text
  status         StatusPengajuan @default(PENDING)
  tanggalDibuat  DateTime        @default(now()) @map("tanggal_dibuat")
  buktiUrl       String?         @map("bukti_url") // Opsional, jika user upload surat dokter

  // Relasi
  pengguna Pengguna @relation(fields: [idPengguna], references: [id], onDelete: Cascade)

  @@map("cuti_izin")
}

model Lembur {
  id            Int             @id @default(autoincrement()) @map("id_lembur")
  idPengguna    Int             @map("id_pengguna")
  tanggalLembur DateTime        @db.Date @map("tanggal_lembur")
  jamMulai      DateTime        @db.Time @map("jam_mulai")
  jamSelesai    DateTime?       @db.Time @map("jam_selesai")
  deskripsi     String          @db.Text
  status        StatusPengajuan @default(PENDING)
  tanggalDibuat DateTime        @default(now()) @map("tanggal_dibuat")

  // Relasi
  pengguna Pengguna @relation(fields: [idPengguna], references: [id], onDelete: Cascade)

  @@map("lembur")
}

model AuditLog {
  id         Int      @id @default(autoincrement()) @map("id_log")
  idPengguna Int      @map("id_pengguna")
  aksi       String?  @map("aksi")
  entityType String?  @map("entity_type")
  entityId   Int?     @map("entity_id")
  nilaiLama  Json?    @map("nilai_lama")
  nilaiBaru  Json?    @map("nilai_baru")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  pengguna Pengguna @relation(fields: [idPengguna], references: [id], onDelete: Cascade)

  @@index([idPengguna, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

model WebhookLog {
  id           Int       @id @default(autoincrement()) @map("id_log")
  deviceId     String?   @map("device_id")
  payload      Json
  status       String?   @map("status")
  errorMessage String?   @map("error_message")
  processedAt  DateTime? @map("processed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([deviceId, createdAt])
  @@map("webhook_log")
}
